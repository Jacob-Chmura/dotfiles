# ==============================================================================
# Requirements & Dependencies
# ==============================================================================
# Executable: i3status
# Target Path: ~/.config/i3status/config

general {
        colors = true
        color_good = "#006400"
        color_degraded = "#808000"
        color_bad = "#8b0000"
        interval = 10
}

order += "wireless _first_"
order += "disk /"
order += "memory"
order += "load"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality @ %essid) %ip"
        format_down = "W: down"
}

disk "/" {
        format = "Disc: %avail"
}

memory {
        format = "Mem: %used"
        threshold_degraded = "1G"
        format_degraded = "Mem: < %available"
}

load {
        format = "Load: %1min"
}

tztime local {
        format = "%Y-%m-%d %H:%M"
}
