# ==============================================================================
# Requirements & Dependencies
# ==============================================================================
# Core:         i3-wm, i3status, dmenu, xss-lock, i3lock, picom, feh
# App Tools:    alacritty, google-chrome, nm-applet, pactl (pulseaudio/pipewire-pulse)
# Display/X11:  xrandr
# Font:         Iosevka Fixed

# ==============================================================================
# Variables & Core Settings
# ==============================================================================

set $mod Mod4

# Font for window titles and bar
font pango:Iosevka Fixed 11px

# Minimalist window borders (removes retro titlebars)
default_border pixel 2
default_floating_border pixel 2

# Toggle back to previously active workspace when pressing current workspace key
workspace_auto_back_and_forth yes

# Use Mouse+$mod to drag floating windows
floating_modifier $mod

# ==============================================================================
# Autostart Services
# ==============================================================================

# Lock screen handler before suspend
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Network applet
exec --no-startup-id nm-applet

# Display configuration (adjust connector name per machine if necessary)
exec --no-startup-id xrandr --output HDMI-0 --rotate left

# Wallpaper
exec_always --no-startup-id feh --no-fehbg --bg-fill ~/.wallpaper.jpg
exec_always --no-startup-id picom --backend glx -b

# ==============================================================================
# Keybindings: Applications & Launchers
# ==============================================================================

bindsym $mod+t exec alacritty
bindsym $mod+g exec google-chrome
bindsym $mod+d exec dmenu_run

# Audio controls (PulseAudio / PipeWire)
set $refresh_i3status killall -SIGUSR1 i3status
bindsym $mod+Shift+0 exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym $mod+Shift+5 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym $mod+Shift+6 exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status

# ==============================================================================
# Keybindings: Navigation & Window Control
# ==============================================================================

# Kill focused window
bindsym $mod+q kill

# Focus navigation (Vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move focused window (Vim keys)
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Window layout & splits
bindsym $mod+s split h
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle

# ==============================================================================
# Workspaces
# ==============================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

# Switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

# Move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

# ==============================================================================
# Session & System Control
# ==============================================================================

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart

# ==============================================================================
# Window Colors (Catppuccin Mocha)
# ==============================================================================
# class                 border  backgr. text    indicator child_border
client.focused          #89b4fa #1e1e2e #cdd6f4 #b4befe   #89b4fa
client.focused_inactive #313244 #1e1e2e #a6adc8 #45475a   #313244
client.unfocused        #313244 #1e1e2e #6c7086 #45475a   #313244
client.urgent           #f38ba8 #1e1e2e #cdd6f4 #f38ba8   #f38ba8
client.placeholder      #313244 #1e1e2e #cdd6f4 #45475a   #313244
client.background       #1e1e2e

# ==============================================================================
# Bar Configuration
# ==============================================================================

bar {
        status_command i3status
        separator_symbol " | "
        position bottom

        colors {
                background #181825
                statusline #cdd6f4
                separator  #585b70

                #                  BORDER  BACKGROUND TEXT
                focused_workspace  #89b4fa #89b4fa    #11111b
                active_workspace   #313244 #313244    #cdd6f4
                inactive_workspace #181825 #181825    #6c7086
                urgent_workspace   #f38ba8 #f38ba8    #11111b
        }
}
